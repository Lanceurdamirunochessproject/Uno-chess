
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>UNO.CHESS</title>

<style>
body {
  margin: 0;
  padding: 20px 10px;
  background: #111827;
  color: white;
  font-family: Arial, sans-serif;
  text-align: center;
}
h1 { color: #facc15; }
h2 { color: #93c5fd; }
#board {
  display: grid;
  grid-template-columns: repeat(8, min(11vw, 65px));
  grid-template-rows: repeat(8, min(11vw, 65px));
  justify-content: center;
  margin: 20px auto;
  border: 4px solid #d1d5db;
  width: fit-content;
}
.square {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: min(8vw, 42px);
  cursor: pointer;
  user-select: none;
}
.light { background: #f0d9b5; }
.dark { background: #b58863; }
.selected { background: #facc15 !important; }
.possible { box-shadow: inset 0 0 0 5px #22c55e; }
button {
  cursor: pointer;
  border: 0;
  border-radius: 8px;
  padding: 10px 14px;
  margin: 5px;
  font-weight: bold;
}
#online { background: #2563eb; color: white; }
#reset { background: #16a34a; color: white; }
#status { color: #93c5fd; font-weight: bold; }
#uno-cards {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 8px;
  max-width: 650px;
  margin: 15px auto;
}
.uno-card {
  width: 48px;
  height: 70px;
  color: white;
  font-size: 17px;
  border: 3px solid white;
  border-radius: 9px;
  box-shadow: 0 3px 6px #0008;
}
.uno-card.selected {
  transform: translateY(-8px);
  outline: 3px solid #facc15;
}
</style>
</head>

<body>
<h1>UNO.CHESS</h1>
<p>Échecs + UNO : un seul jeu !</p>

<h2>Cartes UNO CHESS</h2>
<div id="uno-cards"></div>

<p id="status">Prêt à jouer !</p>

<div>
  <button id="online" onclick="findGame()">JOUER EN LIGNE</button>
  <button id="reset" onclick="resetGame()">Nouvelle partie</button>
</div>

<div id="board"></div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/chess.js/0.10.3/chess.min.js"></script>
<script src="https://cdn.socket.io/4.8.1/socket.io.min.js"></script>

<script>
const game = new Chess();
const board = document.getElementById("board");
const status = document.getElementById("status");

let selected = null;
let possible = [];
let room = null;
let myColor = null;

const socket = io("https://uno-chess-server.onrender.com");

socket.on("connect", () => {
  status.textContent = "Connecté au serveur !";
});

socket.on("waiting", () => {
  status.textContent = "En attente d'un adversaire...";
});

socket.on("game-found", (data) => {
  room = data.room;
  myColor = data.color;
  status.textContent = "Adversaire trouvé ! Tu joues les " + myColor;
});

socket.on("game-action", (data) => {
  if (data.move) {
    game.move({
      from: data.move.from,
      to: data.move.to,
      promotion: data.move.promotion || "q"
    });
    selected = null;
    possible = [];
    drawBoard();
  }
});

function findGame() {
  status.textContent = "Recherche d'un adversaire...";
  socket.emit("find-game");
}

function resetGame() {
  game.reset();
  selected = null;
  possible = [];
  drawBoard();
  status.textContent = "Nouvelle partie !";
}

const pieces = {
  wK:"♔", wQ:"♕", wR:"♖", wB:"♗", wN:"♘", wP:"♙",
  bK:"♚", bQ:"♛", bR:"♜", bB:"♝", bN:"♞", bP:"♟"
};

function drawBoard() {
  board.innerHTML = "";
  const position = game.board();

  for (let r = 0; r < 8; r++) {
    for (let c = 0; c < 8; c++) {
      const square = document.createElement("div");
      const file = "abcdefgh"[c];
      const rank = 8 - r;
      const squareName = file + rank;
      const piece = position[r][c];

      square.className = "square " +
        ((r + c) % 2 === 0 ? "light" : "dark");

      if (piece) {
        square.textContent = pieces[piece.color + piece.type.toUpperCase()];
      }

      if (selected === squareName) {
        square.classList.add("selected");
      }

      if (possible.includes(squareName)) {
        square.classList.add("possible");
      }

      square.onclick = () => clickSquare(squareName);
      board.appendChild(square);
    }
  }
}

function clickSquare(square) {
  if (selected) {
    const move = game.move({
      from: selected,
      to: square,
      promotion: "q"
    });

    if (move) {
      socket.emit("game-action", {
        room: room,
        move: {
          from: move.from,
          to: move.to,
          promotion: move.promotion
        }
      });
      selected = null;
      possible = [];
      drawBoard();
      status.textContent = "Tour des " +
        (game.turn() === "w" ? "blancs" : "noirs");
      return;
    }
  }

  const piece = game.get(square);

  if (piece && piece.color === game.turn()) {
    selected = square;
    possible = game.moves({
      square: square,
      verbose: true
    }).map(move => move.to);
  } else {
    selected = null;
    possible = [];
  }

  drawBoard();
}

drawBoard();
</script>

<script>
const container = document.getElementById("uno-cards");

const colors = {
  red: "#ef4444",
  yellow: "#eab308",
  green: "#16a34a",
  blue: "#2563eb"
};

function addCard(value, color) {
  const card = document.createElement("button");
  card.className = "uno-card";
  card.style.backgroundColor = color;
  card.textContent = value;
  card.onclick = () => card.classList.toggle("selected");
  container.appendChild(card);
}

Object.values(colors).forEach(color => {
  for (let n = 0; n <= 9; n++) {
    addCard(n, color);
  }

  ["+2", "↔", "PASSE"].forEach(value => {
    addCard(value, color);
  });
});
</script>

</body>
</html>
